---
// A device frame with the app's own screen in it (an iframe of /layar/...).
// The frame is the owner's Figma frame with its screen made transparent
// (scripts/olah-bingkai.mjs); everything is placed from the measurements in
// src/data/bingkai.json, so nothing moves when it loads or changes theme.
//
// The screen inside is 402 x 874 pt (iPhone) or 1512 x 982 pt (MacBook),
// scaled to the frame with CSS alone: tan(atan2(a, b)) is a / b as a plain
// number. The phone's screen sits between the frame's status bar and home
// indicator (their measured safe areas), on the UI's own background colour.
//
// The iPhone frame follows the theme of the UI in it, not the page's: "auto"
// follows the page's theme for both (the visitor's setting, or the theme
// button), "terang" and "gelap" fix both. With "auto" both frames are in the
// page (14 KB each), so changing the theme never waits for a picture: a lazy
// device's hidden frame starts loading as the theme button is reached for
// (data-pramuat, hidup/tema.ts).
//
// The screen is a picture of the app, not something to use yet: the iframe is
// inert (no focus, out of the accessibility tree) and the figure is one image
// with a label.
import bingkai from '../data/bingkai.json';
import { teks, type Bahasa } from '../teks';

type Tema = 'auto' | 'terang' | 'gelap';
interface Props {
  jenis: 'laptop' | 'hp';
  bahasa: Bahasa;
  tema?: Tema;
  class?: string;
  /** The widths the frame shows at, for the picture's `sizes`. */
  sizes?: string;
  muat?: 'eager' | 'lazy';
  /** The frame without its status bar, for a screen that draws its own ("Sehari bareng Sulo"). */
  tanpaStatus?: boolean;
}
const { jenis, bahasa, tema = 'auto', class: kelas = '', sizes = '100vw', muat = 'eager', tanpaStatus = false } = Astro.props;
const files = import.meta.glob<string>('../assets/bingkai/*.{webp,png}', { eager: true, query: '?url', import: 'default' });
const url = (name: string) => files[`../assets/bingkai/${name}`]!;
type Berkas = { width: number; height: number; webp: string; png: string };
const b = bingkai.bingkai;
const geo = jenis === 'laptop' ? b.macbook : b['iphone-terang'];
const varian = (id: 'macbook' | 'iphone-terang' | 'iphone-gelap') => {
  const set = b[id].berkas as Record<string, Berkas[]>;
  return (tanpaStatus && set['tanpa-status']) || set.utuh!;
};
const srcset = (list: Berkas[]) => list.map((f) => `${url(f.webp)} ${f.width}w`).join(', ');
const L = geo.layar.persen;
const atas = jenis === 'hp' ? (geo as typeof b['iphone-terang']).safeArea.top : 0;
const bawah = jenis === 'hp' ? (geo as typeof b['iphone-terang']).safeArea.bottom : 0;
const theme = tema === 'auto' ? undefined : tema === 'gelap' ? 'dark' : 'light';
const judul = jenis === 'laptop' ? teks[bahasa].layarLaptop : teks[bahasa].layarHp;
// Which frames: the MacBook has one; an iPhone one per theme ("auto": both, the CSS shows the right one).
const lapis: { berkas: Berkas[]; kelas: string }[] =
  jenis === 'laptop'
    ? [{ berkas: varian('macbook'), kelas: '' }]
    : tema === 'auto'
      ? [
          { berkas: varian('iphone-terang'), kelas: 'perangkat-bingkai--terang' },
          { berkas: varian('iphone-gelap'), kelas: 'perangkat-bingkai--gelap' },
        ]
      : [{ berkas: varian(tema === 'gelap' ? 'iphone-gelap' : 'iphone-terang'), kelas: '' }];
const terbesar = lapis[0]!.berkas[0]!;
---
<figure class:list={['perangkat', `perangkat--${jenis}`, kelas]} style={`--rasio: ${terbesar.width} / ${terbesar.height}`} role="img" aria-label={judul}>
  <div class="perangkat-layar" data-theme={theme} style={`left: ${L.left}%; top: ${L.top}%; width: ${L.width}%; height: ${L.height}%`}>
    <div class="perangkat-isi" style={`--pt-w: ${geo.pt.width}px; --pt-h: ${geo.pt.height}px`}>
      <slot>
        <iframe src={`/layar/${bahasa}/${jenis}/${tema}/`} title={judul} loading={muat} tabindex="-1" inert style={`top: ${atas}px; height: ${geo.pt.height - atas - bawah}px`}></iframe>
      </slot>
    </div>
  </div>
  {lapis.map((l) => (
    <picture class:list={['perangkat-bingkai', l.kelas]}>
      <source type="image/webp" srcset={srcset(l.berkas)} sizes={sizes} />
      <img src={url(l.berkas[0]!.png)} width={terbesar.width} height={terbesar.height} alt="" decoding="async" loading={muat} data-pramuat={tema === 'auto' && muat === 'lazy' ? '' : undefined} />
    </picture>
  ))}
</figure>
