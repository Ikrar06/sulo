---
// One numbered step of a guide: a large number, the title, one or two
// sentences, an optional button (slot "tombol"), and its drawn illustration
// beside it on a wide screen (slot "gambar", described in words by `alt`).
interface Props {
  nomor: number;
  judul: string;
  isi: string;
  /** What the picture shows and what to press, for those who cannot see it. */
  alt: string;
  label: string;
}
const { nomor, judul, isi, alt, label } = Astro.props;
---
<li class="langkah">
  <div class="langkah-teks">
    <p class="langkah-nomor" aria-hidden="true">{nomor}</p>
    <h3><span class="sr-only">{label} {nomor}: </span>{judul}</h3>
    <p>{isi}</p>
    {Astro.slots.has('tombol') && <div class="langkah-tombol"><slot name="tombol" /></div>}
  </div>
  <figure class="langkah-gambar" role="img" aria-label={alt}>
    <slot name="gambar" />
  </figure>
</li>
