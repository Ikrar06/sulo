---
// Every landing page's document: language, title, the stylesheet, and a few
// lines of script before the first paint, from the browser alone (nothing is
// sent anywhere): which download to put first (Android, Chrome, Edge, iPhone
// or another browser; without it both downloads show side by side), whether
// this is an app's built-in browser (Instagram, Facebook, Line, TikTok, where
// a download may not start), and the theme chosen here before, if any.
import '../styles/landing.css';
import { teks, type Bahasa } from '../teks';

interface Props {
  bahasa: Bahasa;
  judul: string;
  deskripsi?: string;
  noindex?: boolean;
}
const { bahasa, judul, deskripsi, noindex = false } = Astro.props;
---
<!doctype html>
<html lang={bahasa}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{judul}</title>
    {deskripsi && <meta name="description" content={deskripsi} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      (function () {
        var d = document.documentElement, u = navigator.userAgent, p = 'lain';
        if (/Android/i.test(u)) p = 'android';
        else if (/iPhone|iPad|iPod/.test(u) || (/Macintosh/.test(u) && navigator.maxTouchPoints > 1)) p = 'ios';
        else if (/Edg\//.test(u)) p = 'edge';
        else if (/Chrome\//.test(u) && !/OPR\//.test(u)) p = 'chrome';
        d.setAttribute('data-perangkat', p);
        if (/Instagram|FBAN|FBAV|FB_IAB|Line\/|musical_ly|BytedanceWebview/.test(u)) d.setAttribute('data-dalam-aplikasi', '');
        try {
          var t = localStorage.getItem('sulo-landing:tema');
          if (t === 'light' || t === 'dark') d.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="lewati" href="#isi">{teks[bahasa].lewati}</a>
    <slot />
  </body>
</html>
