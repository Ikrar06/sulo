---
// Every landing page's document: language, title, the stylesheet, what search
// engines and link previews read (brief 9.4: canonical, hreflang, the social
// card in the page's language, theme-color, favicon, and JSON-LD on the home
// page), and a few lines of script before the first paint, from the browser
// alone (nothing is sent anywhere): which download to put first (Android,
// Chrome, Edge, iPhone or another browser; without it both downloads show
// side by side), whether this is an app's built-in browser (Instagram,
// Facebook, Line, TikTok, where a download may not start), the theme
// chosen here before, if any, and how much the page moves (data-gerak):
// "diam" under reduced motion, "ringan" on a weak device by the phone app's
// own rule (core perf/tier.ts: 3 GB of memory or less, or 4 cores or fewer;
// tests/gerak.test.ts keeps the numbers the same), "penuh" otherwise. Set
// before the first paint so no entrance flashes; without script, nothing
// moves and everything is in its final place.
//
// Absolute addresses need SITE_URL: without it (a local build) none is
// written. A preview build is never indexed.
//
// On the live site the host counts visits (data/mode.ts): its script comes
// from this site's own address, so the policy needs nothing new. The device
// screens (/layar/) have their own document and are not counted.
import '../styles/landing.css';
import { HITUNG_KUNJUNGAN, PRATINJAU } from '../data/mode';
import { alamatHalaman, alamatSitus } from '../data/situs';
import { teks, type Bahasa } from '../teks';

interface Props {
  bahasa: Bahasa;
  judul: string;
  deskripsi?: string;
  noindex?: boolean;
  /** This page's path, for canonical and the other language. */
  path: string;
  /** Structured data for the home page (SoftwareApplication). */
  jsonLd?: Record<string, unknown>;
}
const { bahasa, judul, deskripsi, noindex = false, path, jsonLd } = Astro.props;
const alamat = alamatHalaman(Astro.site, path, bahasa);
const asal = alamatSitus(Astro.site);
const kartu = asal ? `${asal}/kartu/kartu-sosial.${bahasa}.png` : null;
const tanpaIndeks = noindex || PRATINJAU;
---
<!doctype html>
<html lang={bahasa}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{judul}</title>
    {deskripsi && <meta name="description" content={deskripsi} />}
    {tanpaIndeks && <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fafafb" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0b0b0e" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {alamat && (
      <Fragment>
        <link rel="canonical" href={alamat.kanonik} />
        <link rel="alternate" hreflang="id" href={alamat.id} />
        <link rel="alternate" hreflang="en" href={alamat.en} />
        <link rel="alternate" hreflang="x-default" href={alamat.id} />
        <meta property="og:url" content={alamat.kanonik} />
      </Fragment>
    )}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sulo" />
    <meta property="og:title" content={judul} />
    {deskripsi && <meta property="og:description" content={deskripsi} />}
    <meta property="og:locale" content={bahasa === 'en' ? 'en_US' : 'id_ID'} />
    {kartu && (
      <Fragment>
        <meta property="og:image" content={kartu} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={teks[bahasa].judul} />
        <meta name="twitter:card" content="summary_large_image" />
      </Fragment>
    )}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>
      (function () {
        var d = document.documentElement, u = navigator.userAgent, p = 'lain';
        if (/Android/i.test(u)) p = 'android';
        else if (/iPhone|iPad|iPod/.test(u) || (/Macintosh/.test(u) && navigator.maxTouchPoints > 1)) p = 'ios';
        else if (/Edg\//.test(u)) p = 'edge';
        else if (/Chrome\//.test(u) && !/OPR\//.test(u)) p = 'chrome';
        d.setAttribute('data-perangkat', p);
        var mem = navigator.deviceMemory, inti = navigator.hardwareConcurrency;
        var ringan = (mem > 0 && mem * 1024 <= 3072) || (inti > 0 && inti <= 4);
        var diam = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
        d.setAttribute('data-gerak', diam ? 'diam' : ringan ? 'ringan' : 'penuh');
        if (/Instagram|FBAN|FBAV|FB_IAB|Line\/|musical_ly|BytedanceWebview/.test(u)) d.setAttribute('data-dalam-aplikasi', '');
        try {
          var t = localStorage.getItem('sulo-landing:tema');
          if (t === 'light' || t === 'dark') d.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
    <script is:inline>
      // The apps' UI drawn smaller than its own size (data-skala="WxH" or "W": its own size in px) gets its
      // scale here, as plain numbers measured from the box it sits in (--sx, --sy). The stylesheet's own way
      // to that number, tan(atan2()) over container units, comes out wrong in Safari on an iPhone (WebKit
      // 26: the screens showed blank or oversized), so it is only the fallback where no script runs. Each
      // box is watched from the moment it is parsed, and a ResizeObserver answers before the frame is
      // painted: the first paint already has the right scale, and so has every later size.
      (function () {
        if (!window.ResizeObserver || !window.MutationObserver) return;
        var ukuran = new ResizeObserver(function (daftar) {
          for (var i = 0; i < daftar.length; i++) {
            var kotak = daftar[i].contentBoxSize && daftar[i].contentBoxSize[0];
            var w = kotak ? kotak.inlineSize : daftar[i].contentRect.width;
            var h = kotak ? kotak.blockSize : daftar[i].contentRect.height;
            // A hidden box (the laptop on a phone) has no size: it is measured when it shows.
            if (!(w > 0)) continue;
            var anak = daftar[i].target.children;
            for (var j = 0; j < anak.length; j++) {
              var asli = anak[j].getAttribute('data-skala');
              if (!asli) continue;
              asli = asli.split('x');
              var sx = w / asli[0], sy = asli[1] ? h / asli[1] : sx;
              if (anak[j].hasAttribute('data-skala-maks')) sx = sy = Math.min(1, sx);
              anak[j].style.setProperty('--sx', sx);
              anak[j].style.setProperty('--sy', sy);
            }
          }
        });
        function amati() {
          var baru = document.querySelectorAll('[data-skala]:not([data-skala-diamati])');
          for (var i = 0; i < baru.length; i++) {
            baru[i].setAttribute('data-skala-diamati', '');
            ukuran.observe(baru[i].parentElement);
          }
        }
        var parser = new MutationObserver(amati);
        parser.observe(document.documentElement, { childList: true, subtree: true });
        document.addEventListener('DOMContentLoaded', function () {
          amati();
          parser.disconnect();
        });
      })();
    </script>
    {HITUNG_KUNJUNGAN && (
      <Fragment>
        <script is:inline>window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };</script>
        <script is:inline defer src="/_vercel/insights/script.js"></script>
      </Fragment>
    )}
  </head>
  <body>
    <a class="lewati" href="#isi">{teks[bahasa].lewati}</a>
    <slot />
  </body>
</html>
