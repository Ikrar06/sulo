---
// "If something goes wrong": the most common problems, each folded (the
// browser's own <details>, opened by keyboard as well as by touch), and a way
// to report what the list does not cover.
import { ChevronDownIcon } from '@sulo/ui/icons';
import { MASUKAN } from '../data/alamat';
import Tautkan from '../komponen/Tautkan.astro';
import '../styles/bagian/tanya.css';

interface Props {
  judul: string;
  daftar: readonly { t: string; j: string }[];
  /** "Still not working?" and the link to the feedback form. */
  lapor: { tanya: string; tautan: string };
}
const { judul, daftar, lapor } = Astro.props;
---
<section class="panduan-bagian">
  <h2>{judul}</h2>
  <div class="tanya-daftar">
    {daftar.map((m) => (
      <details class="tanya-item">
        <summary>
          <span>{m.t}</span>
          <ChevronDownIcon className="tanya-panah" />
        </summary>
        <div class="tanya-jawab"><p><Tautkan teks={m.j} /></p></div>
      </details>
    ))}
  </div>
  <p class="panduan-lapor">{lapor.tanya} <a class="tautan" href={MASUKAN}>{lapor.tautan}</a></p>
</section>
