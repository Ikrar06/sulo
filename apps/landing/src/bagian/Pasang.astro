---
// Install (brief 6.8; three equal cards since 1.1.0, owner 27 Nov 2026: the
// iPhone was a slim row without a picture), on the plain page; the download
// right on the card (from src/data/rilis.json, like every button). The
// visitor's own device comes first, with the one loud button; the others'
// buttons are quiet. Each card: the moment it leads to, its name, what it is
// (version, size, time, requirement) as quiet chips, one line, then the button
// and its two links at the card's foot. On a wide screen the Android card's
// picture carries a QR code to the Android guide. SHA-256 lives on the guide
// pages, not here.
//
// The iPhone is installed from a laptop: on an iPhone its button is the guide
// (which says to open it on the laptop), elsewhere the .ipa itself.
//
// Once a browser's store has Sulo (rilis.json toko), the extension card leads
// there for that browser and keeps the zip for the other one: Edge's button
// and guide show in Edge, Chrome's everywhere else.
//
// Each card opens with the moment it leads to, drawn as the guides draw it
// (the section's rich visual, brief 4.2): Sulo pinned in the browser on
// SIKOLA, Android asking to install Sulo, and the iPhone's Developer App
// screen where Sulo is trusted. A line under each leads to why a warning
// appears while installing, or why the iPhone app is not in the App Store
// (brief 2: said as it is).
import flame from '../../../extension/assets/brand/flame-full.svg?url';
import { alamatToko, berkas, NAMA_TOKO, type Browser } from '../data/unduhan';
import { pathPasang } from '../data/alamat';
import { buatQr } from '../data/qr';
import { alamatSitus } from '../data/situs';
import { rumah2 } from '../teks/rumah-2';
import { layarOs, panduan } from '../teks/panduan';
import { teks, type Bahasa } from '../teks';
import Hp from '../ilustrasi/Hp.astro';
import Jendela from '../ilustrasi/Jendela.astro';
import { PinIkon, PuzzleIkon } from '../komponen/ikon';
import '../styles/bagian/pasang.css';

interface Props {
  bahasa: Bahasa;
}
const { bahasa } = Astro.props;
const t = rumah2[bahasa].pasang;
const os = layarOs[bahasa];
const ios = panduan[bahasa].iphone.layar;
const zip = berkas('ekstensi', bahasa);
const apk = berkas('android', bahasa);
const ipa = berkas('iphone', bahasa);
const situs = alamatSitus(Astro.site);
const qr = situs ? buatQr(`${situs}${pathPasang(bahasa, 'android')}`) : null;
const meta = (b: typeof zip, waktu: string) => [b.versi ? t.versi(b.versi) : '', b.aktif ? b.ukuran : '', waktu].filter(Boolean);
const BROWSER: Browser[] = ['chrome', 'edge'];
const diToko = BROWSER.filter((b) => alamatToko(b));
const manual = BROWSER.filter((b) => !alamatToko(b));
const NAMA_BROWSER: Record<Browser, string> = { chrome: 'Chrome', edge: 'Edge' };
// With a store in play each browser has its own button and guide; without one, a single zip for both.
const untuk: Record<Browser, string | undefined> = diToko.length ? { chrome: 'tanpa-js android chrome desktop-lain ios', edge: 'edge' } : { chrome: undefined, edge: undefined };
const tampil = diToko.length ? BROWSER : (['chrome'] as Browser[]);
const metaEkstensi = diToko.length ? [zip.versi ? t.versi(zip.versi) : '', ...diToko.map((b) => NAMA_TOKO[b])].filter(Boolean) : meta(zip, t.ekstensi.waktu);
const catatanEkstensi = !diToko.length ? t.ekstensi.manual : manual.length ? t.ekstensi.manualDi(NAMA_BROWSER[manual[0]]) : '';
const mulai = teks[bahasa].unduhMulai;
---
<section class="bagian pasang" id="pasang" aria-labelledby="judul-pasang">
  <div class="isi">
    <header class="bagian-kepala bagian-kepala--tengah">
      <h2 id="judul-pasang">{t.judul}</h2>
      <p>{t.intro}</p>
    </header>
    <div class="pasang-grid">
      <article class="pasang-kartu" data-pasang="ekstensi" data-unduh-wadah>
        <div class="pasang-gambar" aria-hidden="true">
          <Jendela alamat="sikola-v2.unhas.ac.id">
            <PuzzleIkon slot="alat" className="il-ikon il-ikon--alat" />
            <div class="il-menu">
              <p class="il-redup">{os.chrome.ekstensi}</p>
              <p class="il-menu-baris">
                <span class="il-aplikasi"><img src={flame} alt="" width="20" height="20" />Sulo</span>
                <PinIkon className="il-ikon" />
              </p>
            </div>
          </Jendela>
        </div>
        <div class="pasang-isi">
          <h3>{t.ekstensi.judul}</h3>
          <ul class="pasang-meta" role="list">{metaEkstensi.map((m) => <li>{m}</li>)}</ul>
          {catatanEkstensi && <p class="pasang-catatan">{catatanEkstensi}</p>}
        </div>
        <div class="pasang-aksi">
          {tampil.map((b) => {
            const toko = alamatToko(b);
            if (toko) return <a class="tombol tombol--utama tombol--penuh" href={toko} data-untuk={untuk[b]}>{b === 'edge' ? teks[bahasa].pasangEdge : teks[bahasa].pasangChrome}</a>;
            return zip.aktif ? (
              <a class="tombol tombol--utama tombol--penuh" href={zip.href} download={zip.unduhan ? '' : undefined} data-tombol-utama data-menit="3" data-untuk={untuk[b]}>{t.unduhZip}</a>
            ) : (
              <span class="tombol tombol--utama tombol--penuh" aria-disabled="true" data-untuk={untuk[b]}>{zip.ukuran}</span>
            );
          })}
          <p class="pasang-unduh" data-unduh-baris aria-live="polite" data-teks-3={mulai(3)}></p>
          <p class="pasang-tautan">
            {tampil.map((b) => <a class="tautan" href={pathPasang(bahasa, b)} data-untuk={untuk[b]}>{t.panduanEkstensi}</a>)}
            <a class="tautan" href="#tanya-peringatan">{t.peringatan}</a>
          </p>
        </div>
      </article>
      <article class="pasang-kartu" data-pasang="android" data-unduh-wadah>
        <div class="pasang-gambar">
          <div class="pasang-gambar-hp" aria-hidden="true">
            <Hp layar="redup" atas>
              <div class="il-dialog">
                <p class="il-aplikasi"><img src={flame} alt="" width="24" height="24" />Sulo</p>
                <p class="il-teks">{os.android.tanya}</p>
                <p class="il-aksi"><span>{os.android.batal}</span><span class="il-aksi-utama">{os.android.instal}</span></p>
              </div>
            </Hp>
          </div>
          {qr && (
            <div class="pasang-qr">
              <svg viewBox={`0 0 ${qr.ukuran} ${qr.ukuran}`} role="img" aria-label={t.android.qr} shape-rendering="crispEdges"><path d={qr.path} /></svg>
              <p>{t.android.qr}</p>
            </div>
          )}
        </div>
        <div class="pasang-isi">
          <h3>{t.android.judul}</h3>
          <ul class="pasang-meta" role="list">{meta(apk, t.android.waktu).map((m) => <li>{m}</li>)}<li>{t.android.syarat}</li></ul>
        </div>
        <div class="pasang-aksi">
          {apk.aktif ? (
            <a class="tombol tombol--utama tombol--penuh" href={apk.href} download={apk.unduhan ? '' : undefined} data-tombol-utama data-menit="2">{t.unduhApk}</a>
          ) : (
            <span class="tombol tombol--utama tombol--penuh" aria-disabled="true">{apk.ukuran}</span>
          )}
          <p class="pasang-unduh" data-unduh-baris aria-live="polite" data-teks-2={mulai(2)}></p>
          <p class="pasang-tautan">
            <a class="tautan" href={pathPasang(bahasa, 'android')}>{t.panduanAndroid}</a>
            <a class="tautan" href="#tanya-peringatan">{t.peringatan}</a>
          </p>
        </div>
      </article>
      <article class="pasang-kartu" data-pasang="iphone" data-unduh-wadah>
        <div class="pasang-gambar" aria-hidden="true">
          <Hp atas>
            <div class="il-setelan">
              <p class="il-judul-besar">{ios.appPengembang}</p>
              <p class="il-redup">{ios.appleId}</p>
              <p class="il-baris">
                <span class="il-aplikasi"><img src={flame} alt="" width="24" height="24" />Sulo</span>
                <span class="il-aksi-utama">{ios.percayai}</span>
              </p>
            </div>
          </Hp>
        </div>
        <div class="pasang-isi">
          <h3>{t.iphone.judul}</h3>
          <ul class="pasang-meta" role="list">{meta(ipa, t.iphone.waktu).map((m) => <li>{m}</li>)}<li>{t.iphone.syarat}</li></ul>
          <p class="pasang-catatan">{t.iphone.isi}</p>
        </div>
        <div class="pasang-aksi">
          <a class="tombol tombol--utama tombol--penuh" href={pathPasang(bahasa, 'iphone')} data-untuk="ios">{t.iphone.tautan}</a>
          {ipa.aktif ? (
            <a class="tombol tombol--utama tombol--penuh" href={ipa.href} download={ipa.unduhan ? '' : undefined} data-tombol-utama data-menit="10" data-untuk="tanpa-js android chrome edge desktop-lain">{t.iphone.unduh}</a>
          ) : (
            <span class="tombol tombol--utama tombol--penuh" aria-disabled="true" data-untuk="tanpa-js android chrome edge desktop-lain">{ipa.ukuran}</span>
          )}
          <p class="pasang-unduh" data-unduh-baris aria-live="polite" data-teks-10={mulai(10)}></p>
          <p class="pasang-tautan">
            <a class="tautan" href={pathPasang(bahasa, 'iphone')} data-untuk="tanpa-js android chrome edge desktop-lain">{t.iphone.tautan}</a>
            <a class="tautan" href="#tanya-iphone">{t.iphone.tanya}</a>
          </p>
        </div>
      </article>
    </div>
  </div>
</section>
<script>
  import '../hidup/unduh';
</script>
