---
// "Sehari bareng Sulo" (brief 6.5): five moments of one sample day, as short
// rows that take turns left and right (the owner's reference, 02-tiket-3c):
// a square tile holding the top of the phone at that hour, and beside it the
// hour, a title and one line. A whole phone per moment made the section four
// screens long. No sky: the page's own plain background, one tile for all five
// and every phone in the page's theme. The day is told by the hours and the
// lock screens. (Phones that went from the light theme to the dark as evening
// came, on ink tiles, read as a mistake to the owner on both pages, 25 Nov
// 2026.) Each tile's phone rises into it as the row is reached
// (hidup/gerak.ts).
//
// The lock screens' words are the app's own notifications, from the sample
// data (layar/sehari.ts); the app screens are the app's own (iframes).
import { dataContoh } from '../layar/contoh';
import { jamHp, pengingatMalam, ringkasanPagi, tanggalKunci } from '../layar/sehari';
import { rumah } from '../teks/rumah';
import { teks, type Bahasa } from '../teks';
import LayarKunci from '../komponen/LayarKunci.astro';
import Perangkat from '../komponen/Perangkat.astro';
import StatusBar from '../komponen/StatusBar.astro';
import bingkai from '../data/bingkai.json';
import '../styles/bagian/sehari.css';

interface Props {
  bahasa: Bahasa;
}
const { bahasa } = Astro.props;
const t = rumah[bahasa].sehari;
const data = await dataContoh(bahasa);
const pagi = ringkasanPagi(data, bahasa);
const malam = pengingatMalam(data, bahasa);
const tanggal = tanggalKunci(data, bahasa);
const baru = t.baru;
const g = bingkai.bingkai['iphone-terang'];
const atas = g.safeArea.top;
const bawah = g.safeArea.bottom;
// What each moment's phone shows: a lock screen, or one of the app's screens.
const layar = [
  { jenis: 'kunci', notifikasi: pagi },
  { jenis: 'presensi' },
  { jenis: 'kabar' },
  { jenis: 'tugas' },
  { jenis: 'kunci', notifikasi: malam },
] as const;
---
<section class="bagian sehari" aria-labelledby="judul-sehari">
  <div class="isi">
    <header class="bagian-kepala bagian-kepala--tengah">
      <h2 id="judul-sehari">{t.judul}</h2>
      <p>{t.intro}</p>
    </header>
    <ol class="sehari-daftar" role="list">
      {t.momen.map((m, i) => {
        const l = layar[i]!;
        const jam = jamHp(m.jam, bahasa);
        return (
          <li class="momen">
            <div class="momen-teks">
              <p class="momen-jam"><time datetime={`2026-11-25T${m.jam.replace('.', ':')}:00+08:00`}>{jam}</time></p>
              <h3>{m.judul}</h3>
              <p>{m.isi}</p>
            </div>
            <div class="momen-ubin">
            <Perangkat jenis="hp" bahasa={bahasa} tema="auto" tanpaStatus sizes="220px" muat="lazy" class="momen-hp">
              {l.jenis === 'kunci' ? (
                <LayarKunci jam={jam} tanggal={tanggal} judul={l.notifikasi.judul} isi={l.notifikasi.isi} baru={baru} />
              ) : (
                <Fragment>
                  <StatusBar jam={jam} class="momen-status" />
                  <iframe src={`/layar/${bahasa}/hp/${l.jenis}/auto/`} title={teks[bahasa].layarHp} loading="lazy" tabindex="-1" inert style={`top: ${atas}px; height: ${874 - atas - bawah}px`}></iframe>
                </Fragment>
              )}
            </Perangkat>
            </div>
          </li>
        );
      })}
    </ol>
  </div>
</section>
