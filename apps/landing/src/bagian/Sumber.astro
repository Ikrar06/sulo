---
// "Where does it come from?" (brief 6.4): three sources into one. Each says
// what is read; NEOSIA as it is (read only while the student has it open,
// off until turned on). Thin whole lines, names as words, no logos.
import flame from '../../../extension/assets/brand/flame-full.svg?url';
import { rumah } from '../teks/rumah';
import type { Bahasa } from '../teks';
import '../styles/bagian/sumber.css';

interface Props {
  bahasa: Bahasa;
}
const { bahasa } = Astro.props;
const t = rumah[bahasa].sumber;
const sumber = [t.sikola, t.neosia, t.kalender];
---
<section class="bagian sumber" aria-labelledby="judul-sumber">
  <div class="isi">
    <header class="bagian-kepala">
      <h2 id="judul-sumber">{t.judul}</h2>
      <p>{t.intro}</p>
    </header>
    <div class="sumber-diagram">
      <ul class="sumber-daftar" role="list">
        {sumber.map((s) => (
          <li class="sumber-baris">
            <div class="sumber-kartu">
              <p class="sumber-nama">
                {s.nama}
                {'label' in s && <span class="sumber-label">{s.label}</span>}
              </p>
              <p class="sumber-isi">{s.isi}</p>
            </div>
          </li>
        ))}
      </ul>
      <svg class="sumber-garis" viewBox="0 0 100 300" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path d="M0 50C55 50 45 150 100 150" />
        <path d="M0 150H100" />
        <path d="M0 250C55 250 45 150 100 150" />
      </svg>
      <div class="sumber-kartu sumber-kartu--sulo">
        <p class="sumber-nama"><img src={flame} alt="" width="24" height="24" />{t.sulo.nama}</p>
        <p class="sumber-isi">{t.sulo.isi}</p>
      </div>
    </div>
  </div>
</section>
