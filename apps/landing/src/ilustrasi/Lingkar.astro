---
// What to press in a drawn step: an orange ring round it and a small orange
// dot (brief 6.13). Decoration only: the step's words and the figure's label
// say the same thing.
import '../styles/ilustrasi.css';
interface Props {
  class?: string;
}
const { class: kelas } = Astro.props;
---
<span class:list={['il-lingkar', kelas]}><slot /></span>
