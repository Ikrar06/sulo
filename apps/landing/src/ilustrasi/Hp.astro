---
// A plain Android phone, drawn (brief 6.13: like enough to recognise, never a
// copy of any maker's look, no logos): a thin bezel, a punch-hole camera, and
// what the step shows on its screen (slot). Its words follow the page.
interface Props {
  /** "terang" for a light screen, "gelap" for a dark one (a dialog over a dimmed page). */
  layar?: 'terang' | 'redup';
  kecil?: boolean;
}
const { layar = 'terang', kecil = false } = Astro.props;
---
<div class:list={['il-hp', { 'il-hp--kecil': kecil }]}>
  <div class:list={['il-hp-layar', `il-hp-layar--${layar}`]}>
    <span class="il-hp-kamera" aria-hidden="true"></span>
    <slot />
  </div>
</div>
