---
// Phase 1 only: the hero's options side by side for the owner to choose
// (docs/landing/banding-pembuka.html). Not linked, not indexed; removed once
// the choice is made.
import Nav from '../../../komponen/Nav.astro';
import Pembuka from '../../../komponen/Pembuka.astro';
import Dasar from '../../../tata/Dasar.astro';
import { BAHASA, teks, type Bahasa } from '../../../teks';

type Pilihan = { latar: 'a' | 'b' | 'c'; maskot: 'atas' | 'samping'; cip: 'pisah' | 'kalimat'; judul: 'akhir' | 'awal' | 'sorot' };
const dasar: Pilihan = { latar: 'a', maskot: 'atas', cip: 'pisah', judul: 'akhir' };
const PILIHAN: Record<string, Pilihan> = {
  ...Object.fromEntries((['a', 'b', 'c'] as const).flatMap((latar) => (['atas', 'samping'] as const).map((maskot) => [`${latar}-${maskot}`, { ...dasar, latar, maskot }]))),
  'cip-pisah': { ...dasar, cip: 'pisah' },
  'cip-kalimat': { ...dasar, cip: 'kalimat' },
  'judul-akhir': { ...dasar, judul: 'akhir' },
  'judul-awal': { ...dasar, judul: 'awal' },
  'judul-sorot': { ...dasar, judul: 'sorot' },
};
export function getStaticPaths() {
  const names = ['a-atas', 'a-samping', 'b-atas', 'b-samping', 'c-atas', 'c-samping', 'cip-pisah', 'cip-kalimat', 'judul-akhir', 'judul-awal', 'judul-sorot'];
  return BAHASA.flatMap((bahasa) => names.map((pilihan) => ({ params: { bahasa, pilihan } })));
}
const { bahasa, pilihan } = Astro.params as { bahasa: Bahasa; pilihan: string };
const p = PILIHAN[pilihan]!;
---
<Dasar bahasa={bahasa} judul={`Sulo, prototipe pembuka ${pilihan}`} noindex>
  <Nav bahasa={bahasa} />
  <main>
    <Pembuka bahasa={bahasa} {...p} pratinjau />
  </main>
</Dasar>
