---
// Phase 1 only: the tilted iPhones, the finished picture (a) beside the live
// screen in CSS (b), for the 2x comparison. Not linked, not indexed.
import Miring from '../../../komponen/Miring.astro';
import Dasar from '../../../tata/Dasar.astro';
import { BAHASA, type Bahasa } from '../../../teks';

export function getStaticPaths() {
  return BAHASA.map((bahasa) => ({ params: { bahasa } }));
}
const { bahasa } = Astro.params as { bahasa: Bahasa };
---
<Dasar bahasa={bahasa} judul="Sulo, prototipe iPhone miring" noindex>
  <main class="banding-miring">
    <h2>a. Gambar jadi</h2>
    <Miring arah="kiri" tema="terang" bahasa={bahasa} cara="gambar" />
    <Miring arah="kanan" tema="gelap" bahasa={bahasa} cara="gambar" />
    <h2>b. Layar hidup, CSS matrix3d dan mask-image</h2>
    <Miring arah="kiri" tema="terang" bahasa={bahasa} cara="css" />
    <Miring arah="kanan" tema="gelap" bahasa={bahasa} cara="css" />
  </main>
</Dasar>
