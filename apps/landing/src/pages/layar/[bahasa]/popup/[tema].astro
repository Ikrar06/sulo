---
// The extension's popup for the bento tile (an iframe 380 pt wide): the
// extension's own stylesheet, so it looks exactly as it does in Chrome.
import { LayarPopup } from '../../../../layar/LayarPopup';
import { dataContoh } from '../../../../layar/contoh';
import { BAHASA, teks, type Bahasa } from '../../../../teks';
import '../../../../styles/layar-laptop.css';

export function getStaticPaths() {
  return BAHASA.flatMap((bahasa) => ['auto', 'terang', 'gelap'].map((tema) => ({ params: { bahasa, tema } })));
}
const { bahasa, tema } = Astro.params as { bahasa: Bahasa; tema: 'auto' | 'terang' | 'gelap' };
const data = await dataContoh(bahasa);
const theme = tema === 'auto' ? undefined : tema === 'gelap' ? 'dark' : 'light';
---
<html lang={bahasa} data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=380" />
    <meta name="robots" content="noindex" />
    <meta name="color-scheme" content={theme ?? 'light dark'} />
    <title>{teks[bahasa].layarPopup}</title>
    {tema === 'auto' && (
      <script is:inline>
      try {
        var t = localStorage.getItem('sulo-landing:tema');
        if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
      } catch (e) {}
      </script>
    )}
  </head>
  <body>
    <div id="root"><LayarPopup data={data} bahasa={bahasa} /></div>
  </body>
</html>
