---
// One page of the extension's dashboard for the user guide (an iframe 1280 pt
// wide): the same shell and sample data as the home page's MacBook, opened on
// that page (layar/dasbor.ts says which, and what is open on it). It follows
// the page's theme, like the phone's screens: the visitor's setting or the
// theme button's choice, told again by hidup/tema.ts when it changes ("auto"
// in the address is what that script looks for).
import { LayarLaptop } from '../../../../../layar/LayarLaptop';
import { dataContoh } from '../../../../../layar/contoh';
import { dasbor, LAYAR_DASBOR, rincianDari, type LayarDasbor } from '../../../../../layar/dasbor';
import { BAHASA, teks, type Bahasa } from '../../../../../teks';
import '../../../../../styles/layar-laptop.css';

export function getStaticPaths() {
  return BAHASA.flatMap((bahasa) => Object.keys(LAYAR_DASBOR).map((halaman) => ({ params: { bahasa, halaman } })));
}
const { bahasa, halaman } = Astro.params as { bahasa: Bahasa; halaman: LayarDasbor };
const layar = dasbor(halaman);
const data = await dataContoh(bahasa, layar.neosia, 'baru' in layar && layar.baru === true);
const rincian = rincianDari(data, layar.rincian);
---
<html lang={bahasa}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=1280" />
    <meta name="robots" content="noindex" />
    <meta name="color-scheme" content="light dark" />
    <title>{teks[bahasa].layarLaptop}</title>
    <script is:inline>
    try {
      var t = localStorage.getItem('sulo-landing:tema');
      if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
    } catch (e) {}
    // The app scrolls what it points at into view (an opened task, a section). Inside this frame that also scrolled
    // the page around it: /yang-baru/ jumped down to its graded task by itself (27 Nov 2026). Here it scrolls this
    // screen only, to the same place.
    Element.prototype.scrollIntoView = function (arg) {
      var block = arg && typeof arg === 'object' ? arg.block || 'start' : arg === false ? 'end' : 'start';
      var r = this.getBoundingClientRect();
      var dy = block === 'center' ? r.top - (window.innerHeight - r.height) / 2 : block === 'end' ? r.bottom - window.innerHeight : block === 'nearest' ? (r.top < 0 ? r.top : r.bottom > window.innerHeight ? r.bottom - window.innerHeight : 0) : r.top;
      window.scrollBy(0, dy);
    };
    </script>
  </head>
  <body data-ke={layar.ke} style="overflow: visible">
    <div id="root">
      {layar.hidup ? <LayarLaptop client:load data={data} bahasa={bahasa} halaman={layar.halaman} rincian={rincian} /> : <LayarLaptop data={data} bahasa={bahasa} halaman={layar.halaman} rincian={rincian} />}
    </div>
    <script is:inline>
    // A part further down the page (data-ke: an element's id): shown from the start, with no scrolling to watch.
    (function () {
      var id = document.body.getAttribute('data-ke');
      var el = id && document.getElementById(id);
      if (el) window.scrollTo(0, Math.max(0, el.getBoundingClientRect().top + window.scrollY - 24));
    })();
    </script>
  </body>
</html>
