---
// One of the Android app's other screens (Presensi, Kabar, Tugas) for "Sehari
// bareng Sulo": the same shell and sample data as the hero's phone, opened on
// that screen. A daytime moment follows the page's theme ("auto", like the
// hero's phone); an evening one is dark on either page ("gelap").
import { LayarHp } from '../../../../../layar/LayarHp';
import { dataContoh } from '../../../../../layar/contoh';
import { BAHASA, teks, type Bahasa } from '../../../../../teks';
import '../../../../../styles/layar-hp.css';

export function getStaticPaths() {
  const layar = ['presensi', 'kabar', 'tugas'];
  return BAHASA.flatMap((bahasa) => layar.flatMap((l) => ['auto', 'gelap'].map((tema) => ({ params: { bahasa, layar: l, tema } }))));
}
const { bahasa, layar, tema } = Astro.params as { bahasa: Bahasa; layar: 'presensi' | 'kabar' | 'tugas'; tema: 'auto' | 'gelap' };
const data = await dataContoh(bahasa);
const theme = tema === 'auto' ? undefined : 'dark';
---
<html lang={bahasa} data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="color-scheme" content={theme ?? 'light dark'} />
    <title>{teks[bahasa].layarHp}</title>
    {tema === 'auto' && (
      <script is:inline>
      try {
        var t = localStorage.getItem('sulo-landing:tema');
        if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
      } catch (e) {}
      </script>
    )}
  </head>
  <body>
    <div id="root"><LayarHp data={data} bahasa={bahasa} layar={layar} /></div>
  </body>
</html>
