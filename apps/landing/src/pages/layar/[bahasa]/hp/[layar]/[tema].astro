---
// One of the Android app's other screens (Presensi, Kabar, Tugas) for "Sehari
// bareng Sulo": the same shell and sample data as the hero's phone, opened on
// that screen. Fixed light or dark: the moments show the morning in light and
// the night in dark, whatever the page's theme.
import { LayarHp } from '../../../../../layar/LayarHp';
import { dataContoh } from '../../../../../layar/contoh';
import { BAHASA, teks, type Bahasa } from '../../../../../teks';
import '../../../../../styles/layar-hp.css';

export function getStaticPaths() {
  const layar = ['presensi', 'kabar', 'tugas'];
  return BAHASA.flatMap((bahasa) => layar.flatMap((l) => ['terang', 'gelap'].map((tema) => ({ params: { bahasa, layar: l, tema } }))));
}
const { bahasa, layar, tema } = Astro.params as { bahasa: Bahasa; layar: 'presensi' | 'kabar' | 'tugas'; tema: 'terang' | 'gelap' };
const data = await dataContoh(bahasa);
const theme = tema === 'gelap' ? 'dark' : 'light';
---
<html lang={bahasa} data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="color-scheme" content={theme} />
    <title>{teks[bahasa].layarHp}</title>
  </head>
  <body>
    <div id="root"><LayarHp data={data} bahasa={bahasa} layar={layar} /></div>
  </body>
</html>
