---
// One of the Android app's other screens, for "Sehari bareng Sulo" (Presensi,
// Kabar, Tugas) and for the user guide (the rest): the same shell and sample
// data as the hero's phone, opened on that screen (layar/dasbor.ts says which). It follows the page's theme, like the hero's phone: the
// visitor's light or dark setting, or the theme button's choice (read here
// before the first paint, and told again by hidup/tema.ts when it changes).
import { LayarHp } from '../../../../../layar/LayarHp';
import { dataContoh } from '../../../../../layar/contoh';
import { BAHASA, teks, type Bahasa } from '../../../../../teks';
import { hp, LAYAR_HP, rincianDari, type LayarHpNama } from '../../../../../layar/dasbor';
import '../../../../../styles/layar-hp.css';

export function getStaticPaths() {
  return BAHASA.flatMap((bahasa) => Object.keys(LAYAR_HP).map((l) => ({ params: { bahasa, layar: l } })));
}
const { bahasa, layar } = Astro.params as { bahasa: Bahasa; layar: LayarHpNama };
const apa = hp(layar);
const data = await dataContoh(bahasa, apa.neosia);
---
<html lang={bahasa}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="color-scheme" content="light dark" />
    <title>{teks[bahasa].layarHp}</title>
    <script is:inline>
    try {
      var t = localStorage.getItem('sulo-landing:tema');
      if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
    } catch (e) {}
    </script>
  </head>
  <body>
    <div id="root"><LayarHp data={data} bahasa={bahasa} layar={apa.layar} rincian={rincianDari(data, apa.rincian)} /></div>
  </body>
</html>
