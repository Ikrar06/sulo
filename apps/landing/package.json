{
  "name": "@sulo/landing",
  "version": "1.1.0",
  "private": true,
  "description": "Sulo's landing page: static pages, the apps' own UI rendered from their code with sample data.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build && node scripts/layar-miring.mjs && node scripts/sebaris.mjs && node scripts/keamanan.mjs",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.fungsi.json",
    "bingkai": "node scripts/olah-bingkai.mjs",
    "check:bingkai": "node scripts/check-bingkai.mjs",
    "miring": "node scripts/layar-miring.mjs",
    "potret": "node scripts/potret.mjs",
    "test": "vitest run",
    "check:rilis": "node scripts/check-rilis.mjs",
    "check:teks": "node scripts/check-teks.mjs",
    "check:keamanan": "node scripts/check-keamanan.mjs",
    "check:aset": "node scripts/check-aset.mjs",
    "check:landing-layout": "node scripts/check-tata-letak.mjs",
    "check:landing-layout:ci": "node scripts/check-tata-letak.mjs --ci --out=../../.output/landing-layout-gagal"
  },
  "dependencies": {
    "@sulo/core": "workspace:*",
    "@sulo/ui": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@astrojs/react": "7.1.9",
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "astro": "7.4.13",
    "playwright": "1.62.1",
    "qrcode-generator": "1.4.4",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
