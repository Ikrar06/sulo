  },
  "devDependencies": {
    "@astrojs/react": "7.1.9",
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "astro": "7.4.13",
    "playwright": "1.62.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3"
  }
