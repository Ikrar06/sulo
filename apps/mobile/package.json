{
  "name": "@sulo/mobile",
  "version": "0.9.0",
  "private": true,
  "description": "Sulo for Android (Capacitor). Unofficial, not affiliated with Universitas Hasanuddin.",
  "license": "MIT",
  "author": "Ikrar Gempur Tirani",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ikrar06/sulo.git",
    "directory": "apps/mobile"
  },
  "type": "module",
  "scripts": {
    "web": "vite --mode web",
    "maskot:lab": "vite --mode web --port 5199 --strictPort --open /lab/",
    "build:web": "vite build",
    "doctor": "node scripts/doctor.mjs",
    "apk:debug": "node scripts/apk-debug.mjs",
    "install:apk": "node scripts/install-apk.mjs",
    "fetch:apk": "node scripts/fetch-apk.mjs",
    "test:restart": "node scripts/test-restart.mjs",
    "live": "node scripts/live.mjs",
    "web:shots": "node scripts/web-shots.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "node scripts/check-native-logs.mjs && node scripts/check-type-tokens.mjs && node scripts/check-card-layout.mjs && node scripts/tuck-brand-flame.mjs --check",
    "check:fit": "node scripts/check-countdown-fit.mjs && node scripts/check-onboarding-fit.mjs && node scripts/check-status-fit.mjs",
    "check:onboarding-layout": "node scripts/check-onboarding-layout.mjs",
    "emu": "node scripts/emu.mjs",
    "emu:stop": "node scripts/emu.mjs --stop",
    "shots:device": "node scripts/device-shots.mjs",
    "keystore:buat": "node scripts/keystore-create.mjs",
    "check:hosts": "node scripts/check-hosts.mjs",
    "check:version": "node scripts/check-version-code.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/preferences": "8.0.1",
    "@sulo/core": "workspace:*",
    "@sulo/ui": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "playwright": "1.62.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
