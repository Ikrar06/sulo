<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: pnpm mobile:live loads the UI over plain HTTP from the
     laptop's dev server on the local network. Release builds use
     src/main/res/xml/network_security_config.xml (no cleartext at all). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
