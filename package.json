{
  "name": "sulo",
  "version": "0.0.1",
  "private": true,
  "description": "Pendamping akademik untuk mahasiswa Unhas. Tidak resmi.",
  "license": "MIT",
  "author": "Ikrar Gempur Tirani",
  "homepage": "https://github.com/Ikrar06/sulo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ikrar06/sulo.git"
  },
  "bugs": {
    "url": "https://github.com/Ikrar06/sulo/issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wxt",
    "build": "node scripts/check-leaks.mjs && wxt build && node scripts/check-no-dev-code.mjs .output/chrome-mv3 --production",
    "build:dev": "wxt build --mode development",
    "zip": "wxt zip",
    "zip:tester": "wxt zip --mode tester && node scripts/check-no-dev-code.mjs .output/chrome-mv3-tester",
    "typecheck": "wxt prepare && tsc --noEmit",
    "lint": "node scripts/lint-ui.mjs && node scripts/check-leaks.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-leaks": "node scripts/check-leaks.mjs",
    "postinstall": "wxt prepare",
    "sanitize": "node scripts/sanitize.ts",
    "fixtures:compare": "node scripts/compare-fixture-shapes.mjs",
    "privacy": "node scripts/build-privacy.ts",
    "privacy:public": "node scripts/build-public-privacy.ts",
    "calendar:build": "node scripts/calendar/build.ts",
    "calendar:status": "node scripts/calendar/set-status.ts",
    "calendar:publish": "node scripts/calendar/publish.ts",
    "notify-icons": "node scripts/build-notify-icons.mjs",
    "guide:shots": "node scripts/guide-shots.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "playwright": "1.62.1",
    "shadcn": "4.23.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5"
  }
}
