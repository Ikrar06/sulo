{
  "name": "sulo",
  "version": "1.1.0",
  "private": true,
  "description": "Pendamping akademik untuk mahasiswa Unhas. Tidak resmi.",
  "license": "MIT",
  "author": "Ikrar Gempur Tirani",
  "homepage": "https://github.com/Ikrar06/sulo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ikrar06/sulo.git"
  },
  "bugs": {
    "url": "https://github.com/Ikrar06/sulo/issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @sulo/extension dev",
    "build": "node apps/extension/scripts/check-leaks.mjs && pnpm --filter @sulo/extension build",
    "build:dev": "pnpm --filter @sulo/extension build:dev",
    "zip": "pnpm --filter @sulo/extension zip",
    "zip:store": "node apps/extension/scripts/check-leaks.mjs && pnpm --filter @sulo/extension zip:store",
    "zip:tester": "pnpm --filter @sulo/extension zip:tester",
    "store:shots": "pnpm --filter @sulo/extension store:shots",
    "typecheck": "pnpm --filter @sulo/core typecheck && pnpm --filter @sulo/ui typecheck && pnpm --filter @sulo/extension typecheck && pnpm --filter @sulo/mobile run typecheck",
    "lint": "pnpm --filter @sulo/core lint && pnpm --filter @sulo/ui lint && pnpm --filter @sulo/extension lint && pnpm --filter @sulo/mobile run lint && node apps/extension/scripts/check-leaks.mjs",
    "test": "pnpm --filter @sulo/extension test && pnpm --filter @sulo/mobile run test",
    "test:watch": "pnpm --filter @sulo/extension test:watch",
    "check-leaks": "node apps/extension/scripts/check-leaks.mjs",
    "sanitize": "pnpm --filter @sulo/extension sanitize",
    "fixtures:compare": "pnpm --filter @sulo/extension fixtures:compare",
    "privacy": "pnpm --filter @sulo/extension privacy",
    "privacy:public": "pnpm --filter @sulo/extension privacy:public",
    "calendar:build": "pnpm --filter @sulo/extension calendar:build",
    "calendar:status": "pnpm --filter @sulo/extension calendar:status",
    "calendar:publish": "pnpm --filter @sulo/extension calendar:publish",
    "notify-icons": "pnpm --filter @sulo/extension notify-icons",
    "guide:shots": "pnpm --filter @sulo/extension guide:shots",
    "shots:audit": "node scripts/shots.mjs",
    "shots:mockup": "node scripts/mockup.mjs",
    "mobile:web": "pnpm --filter @sulo/mobile run web",
    "mobile:doctor": "pnpm --filter @sulo/mobile run doctor",
    "mobile:apk:debug": "pnpm --filter @sulo/mobile run apk:debug",
    "mobile:install": "pnpm --filter @sulo/mobile run install:apk",
    "mobile:fetch-apk": "pnpm --filter @sulo/mobile run fetch:apk",
    "mobile:test-restart": "pnpm --filter @sulo/mobile run test:restart",
    "mobile:live": "pnpm --filter @sulo/mobile run live",
    "mobile:shots": "pnpm --filter @sulo/mobile run web:shots",
    "maskot:lab": "pnpm --filter @sulo/mobile run maskot:lab",
    "mobile:emu": "pnpm --filter @sulo/mobile run emu",
    "mobile:emu:stop": "pnpm --filter @sulo/mobile run emu:stop",
    "mobile:shots:device": "pnpm --filter @sulo/mobile run shots:device",
    "mobile:keystore:buat": "pnpm --filter @sulo/mobile run keystore:buat",
    "landing:dev": "pnpm --filter @sulo/landing dev",
    "landing:build": "pnpm --filter @sulo/landing build",
    "landing:rilis": "node apps/landing/scripts/rilis.mjs",
    "ios:sync": "pnpm --filter @sulo/mobile run ios:sync",
    "ios:sim": "pnpm --filter @sulo/mobile run ios:sim",
    "ios:live": "pnpm --filter @sulo/mobile run ios:live",
    "ios:live:device": "pnpm --filter @sulo/mobile run ios:live:device",
    "ios:device": "pnpm --filter @sulo/mobile run ios:device",
    "ios:ipa": "pnpm --filter @sulo/mobile run ios:ipa",
    "ios:test": "pnpm --filter @sulo/mobile run ios:test",
    "ios:log": "pnpm --filter @sulo/mobile run ios:log",
    "ios:doctor": "pnpm --filter @sulo/mobile run ios:doctor"
  }
}
